# Quran Foundation Content API credentials (server-only; never use NEXT_PUBLIC_ names)
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Optional: prelive (default) or production
QF_ENV=prelive

# Supabase browser-safe project URL and publishable/anon key (optional; no secrets)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# In Supabase Auth, add http://localhost:3000/auth/callback and the deployed
# https://<your-domain>/auth/callback URL to Redirect URLs. Enable Google and/or
# email magic links there; no service-role key belongs in the browser.

# Stripe Billing — TEST MODE only while developing. All values below are server-only.
# Create the Products/Prices manually in the Stripe Dashboard; do not commit values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
# Canonical public origin only; no trailing path. Required in production for safe Checkout/Portal returns.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Required by billing webhook/database projection; never add to NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# TikTok Content Posting API (server-only; never use NEXT_PUBLIC_ names)
# Register this exact redirect URI with TikTok Login Kit before enabling the integration.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Optional separate AES-256 cookie-encryption secret. If omitted, the server derives a key from TIKTOK_CLIENT_SECRET.
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Set true only after TikTok has audited the Direct Post integration. Unset/false forces private Direct Post behavior.
TIKTOK_DIRECT_POST_AUDITED=false
