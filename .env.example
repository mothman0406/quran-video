# Quran Foundation Content API credentials (server-only; never use NEXT_PUBLIC_ names)
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Optional: prelive (default) or production
QF_ENV=prelive

# Supabase browser-safe project URL and publishable/anon key (optional; no secrets)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
