{
  "name": "quran-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:vad-assets && npm run check:production-config && next build --webpack",
    "check:production-config": "node --experimental-strip-types scripts/check-production-config.ts",
    "check:vad-assets": "node scripts/check-vad-assets.mjs",
    "test": "node --conditions=react-server --experimental-strip-types --test",
    "recognize": "node --experimental-strip-types scripts/recognize.ts",
    "timing:benchmark": "node --experimental-strip-types tools/timing-benchmark/run.ts",
    "timing:benchmark:real": "node --expose-gc --experimental-strip-types tools/timing-benchmark/real-run.ts",
    "timing:benchmark:merge": "node --experimental-strip-types tools/timing-benchmark/merge-real-runs.ts",
    "regression:quran": "node --experimental-strip-types tools/regression/run-quran.ts",
    "analyze:netlify-server": "node scripts/analyze-netlify-server.mjs",
    "check:translation:live": "LIVE_TRANSLATION_CHECK=1 node --experimental-strip-types scripts/check-translation.ts",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@huggingface/transformers": "^3.8.1",
    "@remotion/player": "^4.0.518",
    "@ricky0123/vad-web": "^0.0.30",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.4",
    "@tilawa/core": "0.1.0",
    "fastconformer-onnxruntime-web": "npm:onnxruntime-web@1.24.2",
    "lucide-react": "^1.34.0",
    "mediabunny": "^1.55.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "^4.0.518",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
